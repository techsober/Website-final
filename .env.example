# =============================================================================
# TechSober — environment variables.
# Copy to `.env` for local dev. On Cloudflare Pages set these in the dashboard
# (Settings → Environment variables) or via `wrangler pages secret put NAME`.
#
# Everything is OPTIONAL: the site builds, deploys and degrades gracefully with
# none of these set. Add a key to switch its feature on.
#
# PUBLIC_* vars are inlined into the static output (safe to expose).
# All others are server-only and read by the Cloudflare Pages Functions.
# =============================================================================

# --- Site -------------------------------------------------------------------
# Canonical production origin (used for canonical URLs + sitemap). Build-time.
SITE="https://thetechsober.com"

# --- Cloudflare Web Analytics ----------------------------------------------
# Beacon token from the CF dashboard. Cookieless; no banner needed.
PUBLIC_CF_ANALYTICS_TOKEN=""

# --- MailerLite (email capture) --------------------------------------------
# Set to "true" to enable the capture UI; without the API key the form still
# degrades gracefully.
PUBLIC_MAILERLITE_ENABLED="false"
# Server-only: MailerLite API key + optional group to add subscribers to.
MAILERLITE_API_KEY=""
MAILERLITE_GROUP_ID=""

# --- Contact form email (functions/api/contact.ts) -------------------------
# Preferred provider. Get a key at resend.com and verify your domain.
RESEND_API_KEY=""
# Opt-in fallback (needs SPF/DKIM for your domain). "true" to attempt.
ENABLE_MAILCHANNELS="false"
# Where enquiries are delivered, and the From address.
CONTACT_TO="contact@thetechsober.com"
CONTACT_FROM="TechSober Website <noreply@thetechsober.com>"

# --- Stripe (selling PDFs/workbooks) ---------------------------------------
# v1: paste your Stripe Payment Link URLs (these power the "Get it" buttons).
PUBLIC_STRIPE_LINK_VAULT=""
PUBLIC_STRIPE_LINK_N8N=""
# Future gated delivery (webhook + R2). The webhook is inert until both exist.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Signs the time-limited download tokens (any long random string).
DOWNLOAD_SIGNING_SECRET=""
# NOTE: protected files live in an R2 bucket bound as `DOWNLOADS` (wrangler.toml),
# not an env var.

# --- Giscus (blog comments via GitHub Discussions) -------------------------
# From https://giscus.app after enabling Discussions on your repo.
PUBLIC_GISCUS_REPO=""            # e.g. "techsober/website-final"
PUBLIC_GISCUS_REPO_ID=""
PUBLIC_GISCUS_CATEGORY="Announcements"
PUBLIC_GISCUS_CATEGORY_ID=""

# --- YouTube Data API (future "Latest from YouTube" rail; off by default) ---
# When both are set, the build fetches the 3 newest uploads (cached). Skipped
# entirely if absent so it can never break a build. Mind the daily quota.
YT_API_KEY=""
YT_CHANNEL_ID=""

# --- TinaCMS (optional cloud editing/publishing) ---------------------------
# Local editing needs neither. For cloud, create a project at app.tina.io.
PUBLIC_TINA_CLIENT_ID=""
TINA_TOKEN=""
# TINA_BRANCH=""  # branch Tina commits to (auto-detected if unset)
