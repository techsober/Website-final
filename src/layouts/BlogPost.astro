---
/**
 * BlogPost — single-post template. One <h1>, semantic <article>, 680px reading
 * column, <time datetime>, Article + BreadcrumbList JSON-LD, unique meta,
 * related posts, and Giscus comments. Follows the wireframe's SEO rules.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Chip from "@components/Chip.astro";
import Card from "@components/Card.astro";
import Giscus from "@components/Giscus.astro";
import Icon from "@components/Icon.astro";
import { SITE } from "@lib/site";
import {
  getRelatedPosts,
  formatDate,
  isoDate,
  readingTime,
  slugifyCategory,
  type Post,
} from "@lib/content";

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, description, category, date, cover, coverAlt, author } =
  post.data;

const minutes = readingTime(post.body, post.data.readingTime);
const catSlug = slugifyCategory(category);
const related = await getRelatedPosts(post, 3);
const pageUrl = new URL(`/blog/${post.id}`, SITE.url).href;
const ogImage = cover ?? SITE.ogImage;
const blogThumb = "background:linear-gradient(135deg,var(--off),#EBE1F8)";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished: isoDate(date),
    dateModified: isoDate(date),
    author: {
      "@type": "Person",
      name: author,
      url: new URL("/about", SITE.url).href,
    },
    publisher: {
      "@type": "Organization",
      name: SITE.name,
      logo: {
        "@type": "ImageObject",
        url: new URL("/apple-touch-icon.png", SITE.url).href,
      },
    },
    mainEntityOfPage: pageUrl,
    image: new URL(ogImage, SITE.url).href,
    articleSection: category,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
      {
        "@type": "ListItem",
        position: 2,
        name: "Blog",
        item: new URL("/blog", SITE.url).href,
      },
      { "@type": "ListItem", position: 3, name: title, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={ogImage}
  publishedTime={date.toISOString()}
  modifiedTime={date.toISOString()}
  author={author}
  jsonLd={jsonLd}
>
  <article>
    {/* POST HEADER */}
    <header class="page-head" style="padding-bottom:32px">
      <div class="container">
        <div style="max-width:720px;margin:0 auto">
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href="/">Home</a><span class="sep">/</span>
            <a href="/blog">Blog</a><span class="sep">/</span>
            <a href={`/blog/category/${catSlug}`}>{category}</a>
          </nav>
          <Chip>{category}</Chip>
          <h1 style="margin-top:16px;font-size:clamp(30px,5vw,46px)">{title}</h1>
          <div
            class="meta"
            style="margin-top:18px;color:var(--slate-500);font-size:14.5px;display:flex;gap:10px;align-items:center;flex-wrap:wrap"
          >
            <span>By {author}</span>
            <span class="sep" style="width:4px;height:4px;border-radius:50%;background:var(--slate-300);display:inline-block"></span>
            <time datetime={isoDate(date)}>{formatDate(date)}</time>
            <span class="sep" style="width:4px;height:4px;border-radius:50%;background:var(--slate-300);display:inline-block"></span>
            <span>{minutes} min read</span>
          </div>
        </div>
      </div>
    </header>

    {/* COVER */}
    {
      cover && (
        <div class="container">
          <figure style="max-width:900px;margin:0 auto 8px">
            <img
              src={cover}
              alt={coverAlt ?? `Cover image for ${title}`}
              width={1200}
              height={675}
              style="border-radius:var(--r-card);aspect-ratio:16/9;object-fit:cover;width:100%"
              loading="eager"
              fetchpriority="high"
            />
          </figure>
        </div>
      )
    }

    {/* BODY */}
    <section style="padding-top:48px">
      <div class="container">
        <div class="prose">
          <slot />
        </div>
      </div>
    </section>
  </article>

  {/* RELATED */}
  {
    related.length > 0 && (
      <div class="blogband">
        <section>
          <div class="container">
            <h2 style="font-size:clamp(24px,3vw,30px);margin-bottom:32px">
              Keep reading
            </h2>
            <div class="grid-3">
              {related.map((r) => (
                <Card
                  class="reveal"
                  href={`/blog/${r.id}`}
                  category={r.data.category}
                  title={r.data.title}
                  excerpt={r.data.description}
                  placeholder="Cover"
                  image={r.data.cover}
                  imageAlt={r.data.coverAlt ?? r.data.title}
                  thumbStyle={r.data.cover ? undefined : blogThumb}
                >
                  <span class="meta" slot="footer">
                    {`${readingTime(r.body, r.data.readingTime)} min read · ${formatDate(r.data.date)}`}
                  </span>
                </Card>
              ))}
            </div>
          </div>
        </section>
      </div>
    )
  }

  {/* COMMENTS */}
  <section style="padding-top:64px">
    <div class="container">
      <Giscus />
    </div>
  </section>
</BaseLayout>
