---
/**
 * BlogPost — single-post template. One <h1>, semantic <article>, 680px reading
 * column, <time datetime>, Article + BreadcrumbList JSON-LD, unique meta,
 * related posts, and Giscus comments. Follows the wireframe's SEO rules.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Chip from "@components/Chip.astro";
import Card from "@components/Card.astro";
import Giscus from "@components/Giscus.astro";
import Icon from "@components/Icon.astro";
import { SITE, AUTHOR } from "@lib/site";
import {
  resolveRelatedPosts,
  formatDate,
  isoDate,
  readingTime,
  slugifyCategory,
  type Post,
} from "@lib/content";

interface Props {
  post: Post;
}
const { post } = Astro.props;
const {
  title,
  description,
  category,
  date,
  cover,
  coverAlt,
  seoTitle,
  updatedDate,
  canonicalUrl,
  tags,
  keyTakeaways,
  faqs,
  articleType,
  ogImage: ogImageField,
  sources,
  relatedPosts,
  noindex,
  productName,
  rating,
  pros,
  cons,
  howToSteps,
} = post.data;

const minutes = readingTime(post.body, post.data.readingTime);
const catSlug = slugifyCategory(category);
const related = await resolveRelatedPosts(relatedPosts, post, 3);

// Author identity from site.ts (single default author).
const author = AUTHOR;
const authorInitials = author.name
  .split(/\s+/)
  .map((w) => w[0])
  .slice(0, 2)
  .join("")
  .toUpperCase();
const pageUrl = new URL(`/blog/${post.id}`, SITE.url).href;
const ogImage = ogImageField ?? cover ?? SITE.ogImage;
const blogThumb = "background:linear-gradient(135deg,var(--off),#EBE1F8)";

// SEO fallbacks
const headTitle = seoTitle || title;
const updated = updatedDate ?? date;
const isUpdated = !!updatedDate && isoDate(updatedDate) !== isoDate(date);
const catUrl = new URL(`/blog/category/${catSlug}`, SITE.url).href;

// Article schema — @type is author-selectable (BlogPosting/NewsArticle/Review/HowTo)
const articleLd: Record<string, any> = {
  "@context": "https://schema.org",
  "@type": articleType,
  headline: title,
  description,
  datePublished: isoDate(date),
  dateModified: isoDate(updated),
  author: {
    "@type": "Person",
    name: author.name,
    url: new URL(author.url, SITE.url).href,
    image: new URL(author.avatar, SITE.url).href,
    jobTitle: author.role,
    sameAs: author.sameAs,
  },
  publisher: {
    "@type": "Organization",
    name: SITE.name,
    logo: {
      "@type": "ImageObject",
      url: new URL("/apple-touch-icon.png", SITE.url).href,
    },
  },
  mainEntityOfPage: canonicalUrl || pageUrl,
  image: new URL(ogImage, SITE.url).href,
  articleSection: category,
  inLanguage: "en-GB",
  ...(tags.length ? { keywords: tags.join(", ") } : {}),
};

// Review rich result (first-party review): adds star rating + the item reviewed.
const isReview = articleType === "Review" && typeof rating === "number";
if (isReview) {
  articleLd.itemReviewed = {
    "@type": "Product",
    name: productName || title,
  };
  articleLd.reviewRating = {
    "@type": "Rating",
    ratingValue: rating,
    bestRating: 5,
    worstRating: 1,
  };
}

// HowTo steps (mainly for AI engines; HowTo rich results were retired in Google).
const isHowTo = articleType === "HowTo" && howToSteps.length > 0;
if (isHowTo) {
  articleLd.step = howToSteps.map((s, i) => ({
    "@type": "HowToStep",
    position: i + 1,
    name: s.name,
    text: s.text,
    ...(s.image ? { image: new URL(s.image, SITE.url).href } : {}),
  }));
}

const stars = isReview
  ? "★".repeat(Math.round(rating as number)) +
    "☆".repeat(5 - Math.round(rating as number))
  : "";

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
    { "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog", SITE.url).href },
    { "@type": "ListItem", position: 3, name: category, item: catUrl },
    { "@type": "ListItem", position: 4, name: title, item: pageUrl },
  ],
};

const jsonLd: Record<string, any>[] = [articleLd, breadcrumbLd];
if (faqs.length) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: f.answer },
    })),
  });
}
---

<BaseLayout
  title={headTitle}
  description={description}
  canonical={canonicalUrl}
  noindex={noindex}
  type="article"
  image={ogImage}
  publishedTime={date.toISOString()}
  modifiedTime={updated.toISOString()}
  author={author.name}
  tags={tags}
  jsonLd={jsonLd}
>
  <article>
    {/* POST HEADER */}
    <header class="page-head" style="padding-bottom:32px">
      <div class="container">
        <div style="max-width:720px;margin:0 auto">
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href="/">Home</a><span class="sep">/</span>
            <a href="/blog">Blog</a><span class="sep">/</span>
            <a href={`/blog/category/${catSlug}`}>{category}</a>
          </nav>
          <Chip>{category}</Chip>
          <h1 style="margin-top:16px;font-size:clamp(30px,5vw,46px)">{title}</h1>
          <div
            class="meta"
            style="margin-top:18px;color:var(--slate-500);font-size:14.5px;display:flex;gap:10px;align-items:center;flex-wrap:wrap"
          >
            <span>By {author.name}</span>
            <span class="sep" style="width:4px;height:4px;border-radius:50%;background:var(--slate-300);display:inline-block"></span>
            <time datetime={isoDate(date)}>{formatDate(date)}</time>
            {
              isUpdated && (
                <>
                  <span class="sep" style="width:4px;height:4px;border-radius:50%;background:var(--slate-300);display:inline-block" />
                  <span>Updated {formatDate(updated)}</span>
                </>
              )
            }
            <span class="sep" style="width:4px;height:4px;border-radius:50%;background:var(--slate-300);display:inline-block"></span>
            <span>{minutes} min read</span>
          </div>
        </div>
      </div>
    </header>

    {/* COVER */}
    {
      cover && (
        <div class="container">
          <figure style="max-width:900px;margin:0 auto 8px">
            <img
              src={cover}
              alt={coverAlt ?? `Cover image for ${title}`}
              width={1200}
              height={675}
              style="border-radius:var(--r-card);aspect-ratio:16/9;object-fit:cover;width:100%"
              loading="eager"
              fetchpriority="high"
            />
          </figure>
        </div>
      )
    }

    {/* KEY TAKEAWAYS — answer-first (snippets + AI extraction) */}
    {
      keyTakeaways.length > 0 && (
        <div class="container">
          <aside
            class="takeaways"
            style="max-width:720px;margin:24px auto 0"
            aria-label="Key takeaways"
          >
            <h2>Key takeaways</h2>
            <ul>
              {keyTakeaways.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </aside>
        </div>
      )
    }

    {/* REVIEW VERDICT — star rating + pros/cons (Review rich result) */}
    {
      isReview && (
        <div class="container">
          <aside
            class="verdict"
            style="max-width:720px;margin:24px auto 0"
            aria-label="Review verdict"
          >
            <div class="verdict-head">
              <div>
                <div class="verdict-label">Verdict</div>
                <div class="verdict-product">{productName || title}</div>
              </div>
              <div class="verdict-rating">
                <span class="stars" aria-hidden="true">{stars}</span>
                <span class="verdict-score">{rating}/5</span>
              </div>
            </div>
            {(pros.length > 0 || cons.length > 0) && (
              <div class="verdict-grid">
                {pros.length > 0 && (
                  <div>
                    <h3 class="pros-title">Pros</h3>
                    <ul class="pros">
                      {pros.map((p) => (
                        <li>{p}</li>
                      ))}
                    </ul>
                  </div>
                )}
                {cons.length > 0 && (
                  <div>
                    <h3 class="cons-title">Cons</h3>
                    <ul class="cons">
                      {cons.map((c) => (
                        <li>{c}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            )}
          </aside>
        </div>
      )
    }

    {/* BODY */}
    <section style="padding-top:40px">
      <div class="container">
        <div class="prose">
          <slot />
        </div>
      </div>
    </section>

    {/* HOW-TO STEPS */}
    {
      isHowTo && (
        <section style="padding-top:8px">
          <div class="container">
            <div class="howto">
              <h2 class="howto-title">Steps</h2>
              <ol>
                {howToSteps.map((s) => (
                  <li>
                    <strong>{s.name}</strong>
                    <p>{s.text}</p>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </section>
      )
    }

    {/* FAQ — visible Q&A (matches FAQPage JSON-LD) */}
    {
      faqs.length > 0 && (
        <section style="padding-top:8px">
          <div class="container">
            <div class="faq">
              <h2 class="faq-title">Frequently asked questions</h2>
              {faqs.map((f) => (
                <div class="faq-item">
                  <h3>{f.question}</h3>
                  <p style="white-space:pre-line">{f.answer}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {/* SOURCES — outbound citations (E-E-A-T + AI trust) */}
    {
      sources.length > 0 && (
        <section style="padding-top:8px">
          <div class="container">
            <div class="sources">
              <h2 class="sources-title">Sources</h2>
              <ul>
                {sources.map((s) => (
                  <li>
                    <a href={s.url} target="_blank" rel="noopener noreferrer">
                      {s.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      )
    }

    {/* AUTHOR BIO — E-E-A-T */}
    <section style="padding-top:48px">
      <div class="container">
        <div class="author-box">
          <div class="author-avatar">
            <img
              src={author.avatar}
              alt={`${author.name} — ${author.role}`}
              width="72"
              height="72"
              loading="lazy"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
            />
            <span class="author-monogram" aria-hidden="true">{authorInitials}</span>
          </div>
          <div class="author-meta">
            <div class="author-name">{author.name}</div>
            <div class="author-role">{author.role}</div>
            <p class="author-bio">{author.bio}</p>
            <div class="author-links">
              <a href={author.url}>About</a>
              {
                author.sameAs.map((u) => (
                  <a href={u} target="_blank" rel="noopener noreferrer me">
                    {u.includes("youtube")
                      ? "YouTube"
                      : u.includes("linkedin")
                        ? "LinkedIn"
                        : u.includes("instagram")
                          ? "Instagram"
                          : u.includes("tiktok")
                            ? "TikTok"
                            : u.includes("x.com") || u.includes("twitter")
                              ? "X"
                              : "Website"}
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>
  </article>

  {/* RELATED */}
  {
    related.length > 0 && (
      <div class="blogband">
        <section>
          <div class="container">
            <h2 style="font-size:clamp(24px,3vw,30px);margin-bottom:32px">
              Keep reading
            </h2>
            <div class="grid-3">
              {related.map((r) => (
                <Card
                  class="reveal"
                  href={`/blog/${r.id}`}
                  category={r.data.category}
                  title={r.data.title}
                  excerpt={r.data.excerpt ?? r.data.description}
                  placeholder="Cover"
                  image={r.data.cover}
                  imageAlt={r.data.coverAlt ?? r.data.title}
                  thumbStyle={r.data.cover ? undefined : blogThumb}
                >
                  <span class="meta" slot="footer">
                    {`${readingTime(r.body, r.data.readingTime)} min read · ${formatDate(r.data.date)}`}
                  </span>
                </Card>
              ))}
            </div>
          </div>
        </section>
      </div>
    )
  }

  {/* COMMENTS */}
  <section style="padding-top:64px">
    <div class="container">
      <Giscus />
    </div>
  </section>
</BaseLayout>
