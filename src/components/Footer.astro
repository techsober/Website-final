---
/**
 * Footer — global footer ported 1:1 from the mock. Four zones on desktop,
 * stacked on mobile. Socials + email come from the site config.
 */
import Icon from "./Icon.astro";
import EmailCapture from "./EmailCapture.astro";
import { SITE, SOCIAL_LIST } from "@lib/site";

const year = new Date().getFullYear();
---

<footer>
  <div class="container">
    <div class="foot-grid">
      <div class="foot-brand">
        <a href="/" class="brand" aria-label="TechSober — home"
          >Tech<span>sober</span><span class="dot"></span></a
        >
        <p>
          Honest, hype-free tech and AI — reviews, tools and workflows with the
          costs and limits left in.
        </p>
        <div class="socials">
          {
            SOCIAL_LIST.map((s) => (
              <a
                href={s.href}
                aria-label={s.name}
                target="_blank"
                rel="noopener noreferrer me"
              >
                <Icon name={s.icon} width={18} height={18} />
              </a>
            ))
          }
        </div>
        <div style="margin-top:24px;max-width:300px">
          <h5
            style="font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink);margin-bottom:12px;font-weight:700"
          >
            Newsletter
          </h5>
          <EmailCapture
            source="footer"
            placeholder="you@email.com"
            buttonLabel="Join"
            note="Occasional, no-fluff updates. Unsubscribe anytime."
          />
        </div>
      </div>
      <div class="foot-col">
        <h5>Explore</h5>
        <a href="/portfolio">Portfolio</a>
        <a href="/blog">Blog</a>
        <a href="/projects">Projects</a>
        <a href="/about">About</a>
      </div>
      <div class="foot-col">
        <h5>Resources</h5>
        <a href="/resources">AI workflow PDFs</a>
        <a href="/resources">Free guides</a>
        <a href="/resources">Workbooks</a>
      </div>
      <div class="foot-cta">
        <h5>Collabs</h5>
        <a href="/contact" class="btn btn-primary">Work with TechSober →</a>
        <div class="email">
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </div>
      </div>
    </div>
  </div>
  <div class="foot-bottom">
    © {year} TechSober · Built on Cloudflare Pages
  </div>
</footer>
