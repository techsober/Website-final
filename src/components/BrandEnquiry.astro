---
/**
 * BrandEnquiry — the reusable contact block (Home, Portfolio, About, /contact).
 * Ported 1:1 from the mock. The footer's mini-CTA scrolls here (#enquiry).
 * Posts to /api/contact via fetch with inline success/error states + honeypot.
 */
import Icon from "./Icon.astro";
import Eyebrow from "./Eyebrow.astro";
import { SITE, SOCIALS } from "@lib/site";

interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  /** When true, omit the <section> padding wrapper (e.g. on /contact). */
  bare?: boolean;
  class?: string;
}

const {
  eyebrow = "Work with TechSober",
  title = "Got a product worth an honest look?",
  lead = "I take on a small number of brand collaborations each quarter. Tell me what you're launching and I'll come back with integration options and the rate card.",
  bare = false,
  class: className = "",
} = Astro.props;

const Wrapper = bare ? "div" : "section";
---

<Wrapper id="enquiry" class={className}>
  <div class="container">
    <div class="enquiry">
      <div class="reveal">
        <Eyebrow>{eyebrow}</Eyebrow>
        <h2>{title}</h2>
        <p class="lead">{lead}</p>
        <div class="contact-rows">
          <a href={`mailto:${SITE.email}`}>
            <span class="ic"><Icon name="mail" width={18} height={18} /></span>
            {SITE.email}
          </a>
          <a href={SOCIALS.youtube} target="_blank" rel="noopener noreferrer">
            <span class="ic"><Icon name="youtube" width={18} height={18} /></span
            >
            {SITE.authorHandle} on YouTube
          </a>
        </div>
      </div>
      <div class="form-card reveal">
        <form class="brand-enquiry-form" novalidate>
          <div class="row2">
            <div class="field">
              <label for="be-name">Name</label>
              <input
                id="be-name"
                name="name"
                type="text"
                placeholder="Your name"
                autocomplete="name"
                required
              />
            </div>
            <div class="field">
              <label for="be-email">Email</label>
              <input
                id="be-email"
                name="email"
                type="email"
                placeholder="you@brand.com"
                autocomplete="email"
                required
              />
            </div>
          </div>
          <div class="field">
            <label for="be-company">Brand / Company</label>
            <input
              id="be-company"
              name="company"
              type="text"
              placeholder="Company name"
              autocomplete="organization"
            />
          </div>
          <div class="field">
            <label for="be-budget">Budget range</label>
            <select id="be-budget" name="budget">
              <option>Let's discuss</option>
              <option>Under £250</option>
              <option>£250 – £1,000</option>
              <option>£1,000+</option>
            </select>
          </div>
          <div class="field">
            <label for="be-message">Message</label>
            <textarea
              id="be-message"
              name="message"
              placeholder="What are you launching, and when?"
              required></textarea>
          </div>
          <!-- Honeypot spam-trap: hidden from humans. -->
          <div class="hp-field" aria-hidden="true">
            <label for="be-hp">Leave this field empty</label>
            <input
              id="be-hp"
              type="text"
              name="company_url"
              tabindex="-1"
              autocomplete="off"
            />
          </div>
          <button class="btn btn-primary" type="submit">Send enquiry</button>
          <div class="form-note">Replies within 2 working days.</div>
          <div class="form-ok be-ok" role="status" aria-live="polite"></div>
          <div class="form-err be-err" role="alert" aria-live="assertive"></div>
        </form>
      </div>
    </div>
  </div>
</Wrapper>

<script>
  const form = document.querySelector<HTMLFormElement>(".brand-enquiry-form");
  if (form) {
    const ok = form.querySelector<HTMLElement>(".be-ok")!;
    const err = form.querySelector<HTMLElement>(".be-err")!;
    const btn = form.querySelector<HTMLButtonElement>("button[type=submit]")!;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      ok.classList.remove("show");
      err.classList.remove("show");

      // Lightweight client validation before hitting the network.
      if (!form.checkValidity()) {
        err.textContent = "Please add your name, a valid email and a message.";
        err.classList.add("show");
        return;
      }

      const data = Object.fromEntries(new FormData(form).entries());
      const original = btn.textContent;
      btn.disabled = true;
      btn.textContent = "Sending…";
      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json.ok) {
          ok.textContent =
            json.message || "✓ Thanks — I'll reply within 2 working days.";
          ok.classList.add("show");
          form.reset();
        } else {
          err.textContent =
            json.message || "Something went wrong. Please email me directly.";
          err.classList.add("show");
        }
      } catch {
        err.textContent = "Network error — please try again or email directly.";
        err.classList.add("show");
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }
    });
  }
</script>
