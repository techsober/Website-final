---
/**
 * About — Ashwin Chettiar's story + why TechSober exists, pillars grid, and an
 * optional stat strip. SEO: name + brand in the first paragraph and an h2;
 * Person + Organization JSON-LD with sameAs socials; descriptive portrait alt.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Eyebrow from "@components/Eyebrow.astro";
import Button from "@components/Button.astro";
import Icon from "@components/Icon.astro";
import Stat from "@components/Stat.astro";
import BrandEnquiry from "@components/BrandEnquiry.astro";
import { SITE, SOCIALS } from "@lib/site";
import { getEntry, render } from "astro:content";

// Editable in TinaCMS → "About page". Structured bits are frontmatter; the
// story is the markdown body (free-form rich text).
const entry = await getEntry("pages", "about");
if (!entry) throw new Error("Missing content: src/content/pages/about.md");
const about = entry.data;
const { Content } = await render(entry);

const { pillars, stats } = about;
// Optional portrait. Add one in TinaCMS (or drop a path here) to replace the
// branded monogram placeholder.
const portrait: string | undefined = about.portrait || undefined;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Ashwin Chettiar",
    url: new URL("/about", SITE.url).href,
    jobTitle: "Tech & AI creator",
    worksFor: { "@type": "Organization", name: SITE.name },
    sameAs: Object.values(SOCIALS),
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url,
    founder: { "@type": "Person", name: "Ashwin Chettiar" },
    sameAs: Object.values(SOCIALS),
  },
];
---

<BaseLayout
  title="Ashwin Chettiar — TechSober | Honest Tech & AI"
  description="Ashwin Chettiar is the founder of TechSober — honest tech and AI reviews, tools and workflows with the costs, limits and marketing spin left in."
  jsonLd={jsonLd}
>
  {/* HERO */}
  <div class="page-head">
    <div class="container">
      <div
        style="display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center"
        class="about-hero"
      >
        <div>
          <Eyebrow>{about.eyebrow}</Eyebrow>
          <h1 style="margin-top:14px">{about.title}</h1>
          <p class="sub">{about.intro}</p>
          <div
            style="margin-top:28px;display:flex;gap:14px;flex-wrap:wrap"
          >
            <Button
              variant="primary"
              href={about.primaryHref}
              external={about.primaryHref.startsWith("http")}
            >
              <Icon name="youtube" width={18} height={18} /> {about.primaryLabel}
            </Button>
            <Button variant="secondary" href={about.secondaryHref}
              >{about.secondaryLabel}</Button
            >
          </div>
        </div>
        <div
          class="portrait"
          role="img"
          aria-label={`${about.title}, founder of TechSober`}
          style="aspect-ratio:1/1;max-width:360px;width:100%;margin-left:auto;border-radius:var(--r-card);background:linear-gradient(135deg,var(--lav-100),#e7dcf5);border:1px solid var(--slate-300);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden"
        >
          {
            portrait ? (
              <img
                src={portrait}
                alt={`${about.title}, founder of TechSober`}
                width={360}
                height={360}
                style="width:100%;height:100%;object-fit:cover"
                loading="eager"
              />
            ) : (
              <span
                style="font-size:96px;font-weight:800;color:var(--lav-500);letter-spacing:-.04em;opacity:.85"
                aria-hidden="true"
              >
                AC
              </span>
            )
          }
        </div>
      </div>
    </div>
  </div>

  {/* STORY — free-form rich text from the markdown body (TinaCMS-editable) */}
  <div class="blogband">
    <section>
      <div class="container">
        <div class="prose about-story">
          <Content />
        </div>
      </div>
    </section>
  </div>

  {/* PILLARS */}
  <section>
    <div class="container">
      <div style="margin-bottom:44px">
        <Eyebrow>{about.whatEyebrow}</Eyebrow>
        <h2 style="font-size:clamp(28px,4vw,38px);margin-top:10px">
          {about.pillarsHeading}
        </h2>
      </div>
      <div class="pillar-grid">
        {
          pillars.map((p) => (
            <div class="feature reveal">
              <div class="ico">
                <Icon name={p.icon as any} width={22} height={22} />
              </div>
              <h4 style="font-size:18px;font-weight:600">{p.title}</h4>
              <p>{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* BY THE NUMBERS */}
  <div class="statband">
    <div class="container">
      <div class="stat-grid">
        {stats.map((s) => <Stat value={s.value} label={s.label} />)}
      </div>
    </div>
  </div>

  {/* BRAND ENQUIRY */}
  <BrandEnquiry />
</BaseLayout>

<style>
  @media (max-width: 760px) {
    .about-hero {
      grid-template-columns: 1fr !important;
      gap: 32px !important;
    }
    .about-hero .portrait {
      order: -1;
      margin: 0 !important;
      max-width: 280px !important;
    }
  }
</style>
