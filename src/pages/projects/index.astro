---
/**
 * Projects — list of every web app + AI project, each launchable to its
 * dedicated landing page. Optional client-side category filter. Per wireframe §4.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Eyebrow from "@components/Eyebrow.astro";
import Icon from "@components/Icon.astro";
import BrandEnquiry from "@components/BrandEnquiry.astro";
import { getProjects } from "@lib/content";

const projects = await getProjects();
const cats = ["All", "AI Tools", "Web Apps", "Automations"];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Projects — TechSober",
  description:
    "Working web apps and AI tools you can open and try — each with an honest box on costs and limits.",
};
---

<BaseLayout
  title="Projects — Working AI tools & web apps"
  description="Open and try working AI tools and web apps from TechSober — each with a Launch button and an honest box on what it costs and where it breaks."
  jsonLd={jsonLd}
>
  {/* HEADER */}
  <div class="page-head">
    <div class="container">
      <Eyebrow>Projects</Eyebrow>
      <h1>Tools you can actually open</h1>
      <p class="sub">
        Working web apps and AI agents — not screenshots. Each one launches to a
        live demo and tells you, up front, what it costs and where it breaks.
      </p>
    </div>
  </div>

  {/* FILTER */}
  <div class="filterbar">
    <div class="container">
      <div class="filter-row scroll" role="tablist" aria-label="Filter projects">
        {
          cats.map((c, i) => (
            <button
              class={`filter-pill ${i === 0 ? "active" : ""}`}
              data-filter={c}
              type="button"
            >
              {c}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  {/* PROJECT LIST */}
  <section>
    <div class="container">
      <div class="grid-2" id="project-grid">
        {
          projects.map((p) => (
            <article class="card reveal" data-cat={p.data.category}>
              <div
                class="thumb"
                style={p.data.cover ? undefined : "aspect-ratio:16/9"}
              >
                {p.data.cover ? (
                  <img
                    src={p.data.cover}
                    alt={p.data.coverAlt ?? `${p.data.title} screenshot`}
                    width={640}
                    height={360}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <Icon name="ai" width={40} height={40} stroke={1.5} />
                )}
                {p.data.status && (
                  <span
                    class="status-note"
                    style="position:absolute;top:12px;right:12px"
                  >
                    {p.data.status}
                  </span>
                )}
              </div>
              <div class="body">
                <h3>
                  <a href={`/projects/${p.id}`}>{p.data.title}</a>
                </h3>
                <p>{p.data.description}</p>
                {p.data.tech.length > 0 && (
                  <div class="tags">
                    {p.data.tech.map((t) => (
                      <span class="tag">{t}</span>
                    ))}
                  </div>
                )}
                <div style="margin-top:auto;padding-top:6px">
                  <a class="btn btn-primary" href={`/projects/${p.id}`}>
                    Open app <Icon name="arrow" width={16} height={16} stroke={2} />
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <p
        id="no-projects"
        style="display:none;text-align:center;color:var(--slate-500);padding:32px 0"
      >
        No projects in this category yet.
      </p>
    </div>
  </section>

  <BrandEnquiry />
</BaseLayout>

<script>
  // Client-side category filter (projects don't need crawlable routes; the
  // blog does and uses real URLs instead).
  const pills = document.querySelectorAll<HTMLButtonElement>(".filter-pill");
  const cards = document.querySelectorAll<HTMLElement>("#project-grid .card");
  const empty = document.getElementById("no-projects");
  pills.forEach((pill) =>
    pill.addEventListener("click", () => {
      const filter = pill.dataset.filter;
      pills.forEach((p) => p.classList.toggle("active", p === pill));
      let shown = 0;
      cards.forEach((card) => {
        const match = filter === "All" || card.dataset.cat === filter;
        card.style.display = match ? "" : "none";
        if (match) shown++;
      });
      if (empty) empty.style.display = shown === 0 ? "block" : "none";
    }),
  );
</script>
