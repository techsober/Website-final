---
/**
 * Resources — digital-product cards (cover, title, description, format chip,
 * price or "Free", Get it →). Paid items link to Stripe Payment Links; free
 * items use the MailerLite email-capture lead-magnet flow. Product JSON-LD on
 * paid items. Merch is out of v1 — see the commented placeholder below.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Eyebrow from "@components/Eyebrow.astro";
import Chip from "@components/Chip.astro";
import EmailCapture from "@components/EmailCapture.astro";
import Icon from "@components/Icon.astro";
import { PRODUCTS, formatPrice } from "@data/products";
import { SITE } from "@lib/site";

// Product JSON-LD for paid items (rich results).
const jsonLd = PRODUCTS.filter((p) => !p.free && p.price).map((p) => ({
  "@context": "https://schema.org",
  "@type": "Product",
  name: p.title,
  description: p.description,
  brand: { "@type": "Brand", name: SITE.name },
  offers: {
    "@type": "Offer",
    price: p.price,
    priceCurrency: p.currency,
    availability: "https://schema.org/InStock",
    url:
      p.paymentLink && p.paymentLink !== "#"
        ? p.paymentLink
        : new URL("/resources", SITE.url).href,
  },
}));
---

<BaseLayout
  title="Resources — Practical PDFs & workbooks"
  description="Practical, no-fluff PDFs and workbooks from TechSober — AI workflows, automation guides and honest checklists. Some free, some paid, all useful."
  jsonLd={jsonLd}
>
  {/* HEADER */}
  <div class="page-head">
    <div class="container">
      <Eyebrow>Resources</Eyebrow>
      <h1>Guides worth your time</h1>
      <p class="sub">
        Practical PDFs and workbooks — the workflows, checklists and honest
        guides behind the channel. No filler, no 200-page padding.
      </p>
    </div>
  </div>

  {/* PRODUCT GRID */}
  <div class="blogband">
    <section>
      <div class="container">
        <div class="grid-2">
          {
            PRODUCTS.map((p) => (
              <article class="product-card reveal">
                <div class="product-cover">
                  {p.cover ? (
                    <img
                      src={p.cover}
                      alt={`${p.title} cover`}
                      width={480}
                      height={360}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="cover-label">{p.coverLabel}</span>
                  )}
                </div>
                <Chip>{p.format}</Chip>
                <h3>{p.title}</h3>
                <p class="desc">{p.description}</p>
                <ul class="learn-list">
                  {p.learn.map((l) => (
                    <li>{l}</li>
                  ))}
                </ul>

                {p.free ? (
                  <div style="margin-top:auto">
                    <div
                      class="product-meta"
                      style="margin-bottom:12px;margin-top:0"
                    >
                      <span class="price free">Free</span>
                      <span style="font-size:13px;color:var(--slate-500)">
                        Get it by email
                      </span>
                    </div>
                    <EmailCapture
                      source={`resource-${p.id}`}
                      placeholder="you@email.com"
                      buttonLabel="Email it to me"
                      note="We'll send the PDF and the occasional honest update."
                    />
                  </div>
                ) : (
                  <div class="product-meta">
                    <span class="price">{formatPrice(p)}</span>
                    <a
                      class="btn btn-primary"
                      href={p.paymentLink}
                      {...(p.paymentLink && p.paymentLink !== "#"
                        ? { target: "_blank", rel: "noopener noreferrer" }
                        : {})}
                    >
                      Get it <Icon name="arrow" width={16} height={16} stroke={2} />
                    </a>
                  </div>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  {/* TRUST */}
  <section style="padding-top:80px;padding-bottom:80px">
    <div class="container" style="text-align:center;max-width:680px">
      <h2 style="font-size:clamp(24px,3vw,30px)">No-fluff guarantee</h2>
      <p style="color:var(--slate-500);margin-top:14px">
        Everything here is the same honest standard as the channel. If a paid
        guide isn't genuinely useful to you, email me and I'll refund it — no
        forms, no friction.
      </p>
    </div>
  </section>

  {/*
    ────────────────────────────────────────────────────────────────────────
    MERCH — out of scope for v1. Intentionally renders nothing.
    When ready, drop a product grid here (same .product-card pattern) wired to
    a print-on-demand provider or Stripe products. Leaving the slot documented
    so it can be added without touching the layout above.
    Example:
      <section><div class="container">
        <SectionHead eyebrow="Merch" title="Wear the honesty" />
        <div class="grid-3"> … merch cards … </div>
      </div></section>
    ────────────────────────────────────────────────────────────────────────
  */}
</BaseLayout>
