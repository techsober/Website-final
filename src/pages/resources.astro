---
/**
 * Resources — digital-product cards (cover, title, description, format chip,
 * price or "Free", Get it →). Paid items link to Stripe Payment Links; free
 * items use the MailerLite email-capture lead-magnet flow. Product JSON-LD on
 * paid items. Merch is out of v1 — see the commented placeholder below.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Eyebrow from "@components/Eyebrow.astro";
import Chip from "@components/Chip.astro";
import EmailCapture from "@components/EmailCapture.astro";
import Icon from "@components/Icon.astro";
import { getProducts, formatPrice } from "@lib/content";
import { SITE } from "@lib/site";
import { getEntry, render } from "astro:content";

const products = await getProducts();

// Editable in TinaCMS → "Resources page". Header is frontmatter; the trust
// note is the free-form rich-text body.
const page = await getEntry("pages", "resources");
if (!page) throw new Error("Missing content: src/content/pages/resources.md");
const { Content } = await render(page);

// Product JSON-LD for paid items (rich results).
const jsonLd = products
  .filter((p) => !p.data.free && p.data.price)
  .map((p) => ({
    "@context": "https://schema.org",
    "@type": "Product",
    name: p.data.title,
    description: p.data.description,
    brand: { "@type": "Brand", name: SITE.name },
    offers: {
      "@type": "Offer",
      price: p.data.price,
      priceCurrency: p.data.currency,
      availability: "https://schema.org/InStock",
      url:
        p.data.paymentLink && p.data.paymentLink !== "#"
          ? p.data.paymentLink
          : new URL("/resources", SITE.url).href,
    },
  }));
---

<BaseLayout
  title="Resources — Practical PDFs & workbooks"
  description="Practical, no-fluff PDFs and workbooks from TechSober — AI workflows, automation guides and honest checklists. Some free, some paid, all useful."
  jsonLd={jsonLd}
>
  {/* HEADER */}
  <div class="page-head">
    <div class="container">
      <Eyebrow>{page.data.eyebrow}</Eyebrow>
      <h1>{page.data.title}</h1>
      {page.data.subtitle && <p class="sub">{page.data.subtitle}</p>}
    </div>
  </div>

  {/* PRODUCT GRID */}
  <div class="blogband">
    <section>
      <div class="container">
        <div class="grid-2">
          {
            products.map((entry) => {
              const p = entry.data;
              return (
                <article class="product-card reveal">
                  <div class="product-cover">
                    {p.cover ? (
                      <img
                        src={p.cover}
                        alt={`${p.title} cover`}
                        width={480}
                        height={360}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="cover-label">{p.coverLabel}</span>
                    )}
                  </div>
                  <Chip>{p.format}</Chip>
                  <h3>{p.title}</h3>
                  <p class="desc">{p.description}</p>
                  <ul class="learn-list">
                    {p.learn.map((l) => (
                      <li>{l}</li>
                    ))}
                  </ul>

                  {p.free ? (
                    <div style="margin-top:auto">
                      <div
                        class="product-meta"
                        style="margin-bottom:12px;margin-top:0"
                      >
                        <span class="price free">Free</span>
                        <span style="font-size:13px;color:var(--slate-500)">
                          Get it by email
                        </span>
                      </div>
                      <EmailCapture
                        source={`resource-${entry.id}`}
                        placeholder="you@email.com"
                        buttonLabel="Email it to me"
                        note="We'll send the PDF and the occasional honest update."
                      />
                    </div>
                  ) : (
                    <div class="product-meta">
                      <span class="price">{formatPrice(p)}</span>
                      <a
                        class="btn btn-primary"
                        href={p.paymentLink}
                        {...(p.paymentLink && p.paymentLink !== "#"
                          ? { target: "_blank", rel: "noopener noreferrer" }
                          : {})}
                      >
                        Get it <Icon name="arrow" width={16} height={16} stroke={2} />
                      </a>
                    </div>
                  )}
                </article>
              );
            })
          }
        </div>
      </div>
    </section>
  </div>

  {/* TRUST — free-form rich text from the markdown body (TinaCMS-editable) */}
  <section style="padding-top:80px;padding-bottom:80px">
    <div class="container" style="max-width:680px">
      <div class="prose trust-prose" style="text-align:center">
        <Content />
      </div>
    </div>
  </section>

  {/*
    ────────────────────────────────────────────────────────────────────────
    MERCH — out of scope for v1. Intentionally renders nothing.
    When ready, drop a product grid here (same .product-card pattern) wired to
    a print-on-demand provider or Stripe products. Leaving the slot documented
    so it can be added without touching the layout above.
    Example:
      <section><div class="container">
        <SectionHead eyebrow="Merch" title="Wear the honesty" />
        <div class="grid-3"> … merch cards … </div>
      </div></section>
    ────────────────────────────────────────────────────────────────────────
  */}
</BaseLayout>
