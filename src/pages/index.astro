---
/**
 * Home — the approved mock rebuilt 1:1 as Astro components.
 * Hero · 2×2 button-nav · 3 featured portfolio cards · 3 live blog snippets ·
 * BrandEnquiry · Footer. This page sets the component library the rest reuse.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Eyebrow from "@components/Eyebrow.astro";
import Button from "@components/Button.astro";
import Icon from "@components/Icon.astro";
import SectionHead from "@components/SectionHead.astro";
import Card from "@components/Card.astro";
import MetricPill from "@components/MetricPill.astro";
import BrandEnquiry from "@components/BrandEnquiry.astro";
import { SITE, SOCIALS } from "@lib/site";
import {
  getPublishedPosts,
  formatDate,
  readingTime,
} from "@lib/content";
// Editable in TinaCMS → "Homepage". Strings preserved 1:1 with the mock.
import home from "@data/home.json";

const posts = (await getPublishedPosts()).slice(0, 3);
const { hero, navCards, featuredHeading, featured, blogHeading } = home;

const blogThumb =
  "background:linear-gradient(135deg,var(--off),#EBE1F8)";

// Organization + WebSite JSON-LD for the homepage.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    founder: { "@type": "Person", name: SITE.author },
    sameAs: Object.values(SOCIALS),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.url,
  },
];
---

<BaseLayout
  title={`${SITE.name} — ${SITE.tagline}`}
  description={SITE.description}
  jsonLd={jsonLd}
>
  {/* HERO */}
  <div class="hero">
    <div class="container">
      <span class="eyebrow fu d1">{hero.eyebrow}</span>
      <h1 class="fu d2">{hero.titleLine1}<br /><em>{hero.titleEm}</em></h1>
      <p class="sub fu d3">{hero.subtitle}</p>
      <div class="actions fu d4">
        <Button
          variant="primary"
          href={hero.primaryHref}
          external={hero.primaryHref.startsWith("http")}
          >{hero.primaryLabel}</Button
        >
        <Button variant="secondary" href={hero.secondaryHref}
          >{hero.secondaryLabel}</Button
        >
      </div>
      <div class="trust fu d5">
        <b>{hero.trustStat}</b> {hero.trustStatSuffix}
        {
          hero.trustItems.map((item) => (
            <>
              <span class="sep" /> {item}
            </>
          ))
        }
      </div>
    </div>
  </div>

  {/* BUTTON NAV */}
  <div class="navband">
    <div class="container">
      <div class="nav-grid">
        {
          navCards.map((c) => {
            const external = c.href.startsWith("http");
            return (
              <a
                href={c.href}
                class="nav-card reveal"
                {...(external
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
              >
                <div class="ico">
                  <Icon name={c.icon as any} width={22} height={22} />
                </div>
                <h4>{c.title}</h4>
                <p>{c.desc}</p>
                <span class="arr">{c.arr}</span>
              </a>
            );
          })
        }
      </div>
    </div>
  </div>

  {/* FEATURED PORTFOLIO */}
  <section>
    <div class="container">
      <SectionHead
        class="reveal"
        eyebrow={featuredHeading.eyebrow}
        title={featuredHeading.title}
        linkHref={featuredHeading.linkHref}
        linkLabel={featuredHeading.linkLabel}
      />
      <div class="grid-3">
        {
          featured.map((f) => (
            <Card
              class="reveal"
              href={f.href}
              category={f.category}
              title={f.title}
              excerpt={f.excerpt}
              play
              placeholder="Your still"
            >
              <MetricPill slot="footer">{f.metric}</MetricPill>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  {/* BLOG SNIPPETS (live from the content collection) */}
  <div class="blogband">
    <section>
      <div class="container">
        <SectionHead
          class="reveal"
          eyebrow={blogHeading.eyebrow}
          title={blogHeading.title}
          linkHref={blogHeading.linkHref}
          linkLabel={blogHeading.linkLabel}
        />
        <div class="grid-3">
          {
            posts.map((post) => (
              <Card
                class="reveal"
                href={`/blog/${post.id}`}
                category={post.data.category}
                title={post.data.title}
                excerpt={post.data.excerpt ?? post.data.description}
                placeholder="Cover"
                image={post.data.cover}
                imageAlt={post.data.coverAlt ?? post.data.title}
                thumbStyle={post.data.cover ? undefined : blogThumb}
              >
                <span class="meta" slot="footer">
                  {`${readingTime(post.body, post.data.readingTime)} min read · ${formatDate(post.data.date)}`}
                </span>
              </Card>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  {/* BRAND ENQUIRY */}
  <BrandEnquiry />
</BaseLayout>
