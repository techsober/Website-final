---
/**
 * Portfolio — header, swappable stat strip, project cards with category chip
 * + gold result pill, "View more videos" CTA, BrandEnquiry. Per wireframe §2.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Eyebrow from "@components/Eyebrow.astro";
import Card from "@components/Card.astro";
import MetricPill from "@components/MetricPill.astro";
import Stat from "@components/Stat.astro";
import Button from "@components/Button.astro";
import BrandEnquiry from "@components/BrandEnquiry.astro";
import Icon from "@components/Icon.astro";
import { SOCIALS } from "@lib/site";

// PLACEHOLDER stats — swap for your real, strongest numbers. Each <Stat> is a
// swappable component so these can later become live YouTube Data API counts.
const stats = [
  { value: "2.4M", label: "Total views" },
  { value: "4.3K", label: "Subscribers" },
  { value: "18", label: "Brand collabs" },
  { value: "61%", label: "Avg. retention" },
];

// 3–5 best projects. Result pill = the metric that matters (gold).
const projects = [
  {
    href: "/projects/hermes-agent",
    category: "AI",
    title: "Hermes Agent: full setup walkthrough",
    excerpt:
      "Step-by-step build of an autonomous agent for a dev-tools sponsor — costs and limits shown on screen, not hidden.",
    metric: "128k views in 30 days",
  },
  {
    href: "/blog/honest-headphone-review-two-weeks",
    category: "Review",
    title: "The honest headphone review",
    excerpt:
      "A two-week long-term review for an audio brand that asked for the real verdict — and got it.",
    metric: "+1,900 subscribers",
  },
  {
    href: "/projects/market-research-agent",
    category: "AI",
    title: "Stock & crypto research agent",
    excerpt:
      "Wiring live market data into an AI workflow for a fintech launch — including where it breaks and why.",
    metric: "9.2% avg retention lift",
  },
  {
    href: "/blog/local-ai-on-cheap-hardware",
    category: "Gadgets",
    title: "Local AI on cheap hardware",
    excerpt:
      "A hardware-sponsored deep dive into running models locally — benchmarks, heat, and the honest cost.",
    metric: "92k views · 6.1% CTR",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Portfolio — TechSober",
  description:
    "Selected tech and AI work from TechSober — honest reviews, AI builds and brand collaborations with the results that matter.",
};
---

<BaseLayout
  title="Portfolio — Selected work"
  description="Selected tech and AI work from TechSober: honest reviews, AI builds and brand collaborations, with the headline numbers that matter."
  jsonLd={jsonLd}
>
  {/* HEADER */}
  <div class="page-head">
    <div class="container">
      <Eyebrow>Portfolio</Eyebrow>
      <h1>Selected work</h1>
      <p class="sub">
        A calm grid of my strongest tech and AI work — the briefs, what I made,
        and the numbers they actually moved.
      </p>
    </div>
  </div>

  {/* STAT STRIP */}
  <div class="statband">
    <div class="container">
      <div class="stat-grid">
        {stats.map((s) => <Stat value={s.value} label={s.label} />)}
      </div>
    </div>
  </div>

  {/* PROJECT GRID */}
  <section>
    <div class="container">
      <div class="grid-2">
        {
          projects.map((p) => (
            <Card
              class="reveal"
              href={p.href}
              category={p.category}
              title={p.title}
              excerpt={p.excerpt}
              play
              placeholder="Work sample"
            >
              <MetricPill slot="footer">{p.metric}</MetricPill>
            </Card>
          ))
        }
      </div>

      {/* VIEW MORE */}
      <div class="center-cta">
        <Button variant="primary" href={SOCIALS.youtube} external>
          <Icon name="youtube" width={18} height={18} /> View more videos
        </Button>
      </div>
    </div>
  </section>

  {/* BRAND ENQUIRY */}
  <BrandEnquiry />
</BaseLayout>
