---
/**
 * Portfolio — header, swappable stat strip, project cards with category chip
 * + gold result pill, "View more videos" CTA, BrandEnquiry. Per wireframe §2.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Eyebrow from "@components/Eyebrow.astro";
import Card from "@components/Card.astro";
import MetricPill from "@components/MetricPill.astro";
import Stat from "@components/Stat.astro";
import Button from "@components/Button.astro";
import BrandEnquiry from "@components/BrandEnquiry.astro";
import Icon from "@components/Icon.astro";
// Editable in TinaCMS → "Portfolio page". Each <Stat> stays a swappable
// component so numbers can later be fed by the YouTube Data API.
import portfolio from "@data/portfolio.json";

const { stats, projects } = portfolio;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Portfolio — TechSober",
  description:
    "Selected tech and AI work from TechSober — honest reviews, AI builds and brand collaborations with the results that matter.",
};
---

<BaseLayout
  title="Portfolio — Selected work"
  description="Selected tech and AI work from TechSober: honest reviews, AI builds and brand collaborations, with the headline numbers that matter."
  jsonLd={jsonLd}
>
  {/* HEADER */}
  <div class="page-head">
    <div class="container">
      <Eyebrow>{portfolio.eyebrow}</Eyebrow>
      <h1>{portfolio.title}</h1>
      <p class="sub">{portfolio.subtitle}</p>
    </div>
  </div>

  {/* STAT STRIP */}
  <div class="statband">
    <div class="container">
      <div class="stat-grid">
        {stats.map((s) => <Stat value={s.value} label={s.label} />)}
      </div>
    </div>
  </div>

  {/* PROJECT GRID */}
  <section>
    <div class="container">
      <div class="grid-2">
        {
          projects.map((p) => (
            <Card
              class="reveal"
              href={p.href}
              category={p.category}
              title={p.title}
              excerpt={p.excerpt}
              play
              placeholder="Work sample"
            >
              <MetricPill slot="footer">{p.metric}</MetricPill>
            </Card>
          ))
        }
      </div>

      {/* VIEW MORE */}
      <div class="center-cta">
        <Button
          variant="primary"
          href={portfolio.viewMoreHref}
          external={portfolio.viewMoreHref.startsWith("http")}
        >
          <Icon name="youtube" width={18} height={18} /> {portfolio.viewMoreLabel}
        </Button>
      </div>
    </div>
  </section>

  {/* BRAND ENQUIRY */}
  <BrandEnquiry />
</BaseLayout>
